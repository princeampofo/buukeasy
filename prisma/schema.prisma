generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum - simplified
enum UserRole {
  ENTREPRENEUR
  ADMIN
}

// Service categories
enum ServiceCategory {
  HAIR_SERVICES
  NAIL_CARE
  SKIN_CARE
  BARBERING
  BEAUTY_TREATMENT
  MASSAGE
  OTHER
}

// Booking status
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  MODIFIED
  NO_SHOW
}

// Payment status
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// Users table (Entrepreneurs only)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  phone       String?
  role        UserRole @default(ENTREPRENEUR)
  avatar      String?
  isVerified  Boolean  @default(false)
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Entrepreneur relations
  entrepreneurProfile EntrepreneurProfile?
  bookingsAsProvider  Booking[]            @relation("ProviderBookings")
  
  // Settings relations
  notificationSettings NotificationSettings?

  @@map("users")
}

// Entrepreneur profile
model EntrepreneurProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  businessName    String
  slug            String          @unique
  description     String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  timezone        String          @default("Eastern Time")
  currency        String          @default("USD")
  isActive        Boolean         @default(true)
  isVerified      Boolean         @default(false)
  averageRating   Float           @default(0)
  totalReviews    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]
  timeSlots       TimeSlot[]
  portfolioImages PortfolioImage[]

  @@map("entrepreneur_profiles")
}

// Services
model Service {
  id                   String          @id @default(cuid())
  entrepreneurId       String
  name                String
  category            ServiceCategory
  description         String?
  duration            Int
  price               Float
  bufferTime          Int             @default(0)
  requireDeposit      Boolean         @default(false)
  minAdvanceHours     Int             @default(1)
  maxAdvanceDays      Int             @default(30)
  specialInstructions String?
  imageUrl            String?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  entrepreneur        EntrepreneurProfile @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  bookings            Booking[]

  @@map("services")
}

// Time slots for availability
model TimeSlot {
  id               String   @id @default(cuid())
  entrepreneurId   String
  dayOfWeek        Int
  startTime        String
  endTime          String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entrepreneur     EntrepreneurProfile @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  @@map("time_slots")
}

// Bookings - Modified for customer details without account
model Booking {
  id               String        @id @default(cuid())
  customerName     String
  customerEmail    String
  customerPhone    String?
  providerId       String
  serviceId        String
  appointmentDate  DateTime
  appointmentTime  String
  status           BookingStatus @default(PENDING)
  duration         Int
  totalAmount      Float
  specialRequests  String?
  cancelReason     String?
  cancelledAt      DateTime?
  confirmedAt      DateTime?
  completedAt      DateTime?
  modifiedAt       DateTime?
  modificationNote String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  provider         User          @relation("ProviderBookings", fields: [providerId], references: [id])
  service          Service       @relation(fields: [serviceId], references: [id])
  payment          Payment?

  @@map("bookings")
}

// Payment tracking
model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  amount          Float
  platformFee     Float
  entrepreneurFee Float
  paymentMethod   String
  paymentIntentId String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

// Portfolio images for entrepreneurs
model PortfolioImage {
  id               String   @id @default(cuid())
  entrepreneurId   String
  imageUrl         String
  caption          String?
  createdAt        DateTime @default(now())

  entrepreneur     EntrepreneurProfile @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)

  @@map("portfolio_images")
}

// Platform settings
model PlatformSettings {
  id                    String   @id @default(cuid())
  platformFeePercentage Float    @default(10.0)
  minBookingFee         Float    @default(5.0)
  maxBookingFee         Float    @default(50.0)
  cancellationWindow    Int      @default(24)
  autoConfirmBookings   Boolean  @default(false)
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}

// Notification settings
model NotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  emailBookings     Boolean  @default(true)
  emailCancellations Boolean  @default(true)
  emailReminders    Boolean  @default(true)
  smsBookings       Boolean  @default(false)
  smsCancellations  Boolean  @default(false)
  smsReminders      Boolean  @default(false)
  marketingEmails   Boolean  @default(true)
  weeklyReports     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}